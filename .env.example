# =============================================================================
# Cricket Commentary Automation — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Application ---
APP_ENV=development                       # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG                       # DEBUG | INFO | WARNING | ERROR

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cricket_commentary
POSTGRES_USER=cricket
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_MATCH_STATE_DB=1                    # Separate DB for live match state
REDIS_CELERY_BROKER_DB=2                  # Separate DB for Celery broker

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# --- Cricket Data Feed ---
# Provider: "cricketdata" | "entitysport"
DATA_FEED_PROVIDER=cricketdata
CRICKETDATA_API_KEY=your_api_key_here
CRICKETDATA_BASE_URL=https://api.cricapi.com/v1
# ENTITYSPORT_API_KEY=your_api_key_here  # Uncomment if using EntitySport
# ENTITYSPORT_BASE_URL=https://rest.entitysport.com/v2

# Polling interval in seconds (8s default for live stream, 30s for budget CricketData)
DATA_POLL_INTERVAL_SECONDS=8

# --- TTS (Text-to-Speech) ---
# Provider: "edge_tts" | "sarvam" | "elevenlabs" | "google_cloud"
# 
# RECOMMENDED: Sarvam AI (natural Hindi voice, free tier, best for cricket commentary)
#   Get a free key at: https://www.sarvam.ai/
#   Voices: meera | pavithra | maitreyi | arvind | amol | amartya (default)
TTS_PROVIDER=edge_tts                      # Change to "sarvam" for natural Hindi voice
TTS_VOICE_ID=hi-IN-MadhurNeural           # Edge TTS Hindi male voice (better for sports)
# TTS_VOICE_ID=hi-IN-SwaraNeural          # Edge TTS Hindi female voice
TTS_OUTPUT_FORMAT=mp3
TTS_SAMPLE_RATE=24000

# Sarvam AI (best free natural Hindi TTS — set TTS_PROVIDER=sarvam to activate)
# SARVAM_API_KEY=your_sarvam_key_here
# TTS_VOICE_ID=amartya                    # Best broadcast-style male voice for commentary

# ElevenLabs (uncomment when upgrading)
# ELEVENLABS_API_KEY=your_api_key_here
# ELEVENLABS_VOICE_ID=your_voice_id_here
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5     # Flash for routine, multilingual_v2 for major

# --- LLM (Commentary Generation) ---
# Provider: "bedrock" | "ollama"
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0    # Budget default
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0  # Upgrade path
BEDROCK_MAX_TOKENS=300
BEDROCK_TEMPERATURE=0.8

# Ollama (uncomment for free local LLM)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- Langfuse (Observability) ---
LANGFUSE_PUBLIC_KEY=your_public_key_here
LANGFUSE_SECRET_KEY=your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# --- YouTube / RTMP Streaming ---
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=your_stream_key_here

# --- ffmpeg ---
FFMPEG_PATH=ffmpeg                         # System path or absolute path
FFMPEG_VIDEO_BITRATE=2500k
FFMPEG_AUDIO_BITRATE=128k
FFMPEG_FRAMERATE=30
FFMPEG_RESOLUTION=1920x1080

# --- Graphics / Scorecard ---
SCORECARD_TEMPLATE_PATH=templates/scorecard/index.html
PLAYWRIGHT_SCREENSHOT_WIDTH=1920
PLAYWRIGHT_SCREENSHOT_HEIGHT=1080

# --- Cost Tracking ---
COST_TRACKING_ENABLED=true
MONTHLY_BUDGET_ALERT_INR=1000              # Alert if monthly cost exceeds this
